#=== V01 COM.020 Premissas Producao por Produto
v='Tela_04_Novos_View_01_Pivot_Premissas_Producao_por_Produto';
ViewCreate(c20,v);
ViewSubsetAssign(c20,v,sCal,'zCal_2607');
ViewSubsetAssign(c20,v,sVer,'zTela03_VerT1');
ViewSubsetAssign(c20,v,sPro,'zProd_Itens');
ViewSubsetAssign(c20,v,sCan,'zTela03_CanalTot');
ViewSubsetAssign(c20,v,sPrz,'zTela03_PrazoTot');
ViewSubsetAssign(c20,v,sTip,'zTela03_TipoTot');
ViewSubsetAssign(c20,v,m20,'zM_COM020_Prem');
ViewColumnDimensionSet(c20,v,sPro,1);
ViewRowDimensionSet(c20,v,m20,1);
ViewTitleDimensionSet(c20,v,sCal);
ViewTitleDimensionSet(c20,v,sVer);
ViewTitleDimensionSet(c20,v,sCan);
ViewTitleDimensionSet(c20,v,sPrz);
ViewTitleDimensionSet(c20,v,sTip);
ViewExtractSkipZeroesSet(c20,v,1);

