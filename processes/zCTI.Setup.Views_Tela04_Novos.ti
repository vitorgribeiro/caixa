#region Prolog
sCal='ALL.D.Calendario'; sSaf='ALL.D.Safra'; sVer='ALL.D.Versao';
sPro='ALL.D.Produto'; sCan='ALL.D.Canal'; sPrz='ALL.D.Prazo';
sTip='ALL.D.Tipo_Pessoa'; sMob='CRT.D.MOB';
