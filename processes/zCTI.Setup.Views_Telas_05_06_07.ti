#region Prolog
sCal='ALL.D.Calendario'; sSaf='ALL.D.Safra'; sVer='ALL.D.Versao';
sOri='ALL.D.Origem'; sPro='ALL.D.Produto'; sCan='ALL.D.Canal'; sPrz='ALL.D.Prazo';
c50='CRT.050.Carteira_Consolidada'; m50='CRT.M.050.Carteira_Consolidada';
cRE='REC.100.Receita_Financeira'; mRE='REC.M.100.Receita_Financeira';

#=== TELA 06 - Consolidado V01 Pivot Origem Mensal
v='Tela_06_Consolidado_View_01_Pivot_Origem_Mensal';
ViewCreate(c50,v);
ViewSubsetAssign(c50,v,sCal,'zTela03_CalProj');
ViewSubsetAssign(c50,v,sSaf,'zTela03_SafraTot');
ViewSubsetAssign(c50,v,sVer,'zTela03_VerT1');
ViewSubsetAssign(c50,v,sOri,'zOri_Todas');
ViewSubsetAssign(c50,v,sPro,'zTela03_ProdTot');
ViewSubsetAssign(c50,v,sCan,'zTela03_CanalTot');
ViewSubsetAssign(c50,v,sPrz,'zTela03_PrazoTot');
ViewSubsetAssign(c50,v,m50,'zM_CRT050_Motor');
ViewColumnDimensionSet(c50,v,sCal,1);
ViewRowDimensionSet(c50,v,sOri,1);
ViewRowDimensionSet(c50,v,m50,2);
ViewTitleDimensionSet(c50,v,sSaf);
ViewTitleDimensionSet(c50,v,sVer);
ViewTitleDimensionSet(c50,v,sPro);
ViewTitleDimensionSet(c50,v,sCan);
ViewTitleDimensionSet(c50,v,sPrz);
ViewExtractSkipZeroesSet(c50,v,1);

#=== TELA 07 - Consolidado Safra V01 Linha Saldo por Origem
