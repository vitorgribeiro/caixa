ViewSubsetAssign(c50,v,sPrz,'zTela03_PrazoTot');
ViewSubsetAssign(c50,v,m50,'zM_CRT050_SF');
ViewRowDimensionSet(c50,v,sCal,1);
ViewColumnDimensionSet(c50,v,sOri,1);
ViewTitleDimensionSet(c50,v,sSaf);
ViewTitleDimensionSet(c50,v,sVer);
ViewTitleDimensionSet(c50,v,sPro);
