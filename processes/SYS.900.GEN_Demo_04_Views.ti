#=== Tela 1 - Carga Existentes ===
sC = 'CRT.030.Carteira_Existentes'; sV = 'RPT.Tela1_Carga_Existentes';
IF( ViewExists( sC, sV ) = 1 ); ViewDestroy( sC, sV ); ENDIF;
ViewCreate( sC, sV );
ViewSubsetAssign( sC, sV, 'ALL.D.Safra', 'SYS.Safras_Ativas' ); ViewRowDimensionSet( sC, sV, 'ALL.D.Safra', 1 );
ViewSubsetAssign( sC, sV, 'CRT.M.030.Carteira_Existentes', 'SYS.Met_Carga' ); ViewColumnDimensionSet( sC, sV, 'CRT.M.030.Carteira_Existentes', 1 );
ViewSubsetAssign( sC, sV, 'ALL.D.Calendario', 'SYS.Sel_Cal_2407' );
ViewSubsetAssign( sC, sV, 'ALL.D.Versao', 'SYS.Sel_Ver_RE' );
ViewSubsetAssign( sC, sV, 'ALL.D.Produto', 'SYS.Sel_Prod_Tot' );
ViewSubsetAssign( sC, sV, 'ALL.D.Canal', 'SYS.Sel_Canal_Tot' );
