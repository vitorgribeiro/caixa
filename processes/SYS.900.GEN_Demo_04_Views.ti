#region Prolog
#--- Views RPT.Tela* + subsets. Titulos via subset de 1 elemento (ViewTitleElementSet aborta nesta versao). Idempotente. ---

#=== Subsets de eixo (metrica / produto / origem) ===
IF( SubsetExists( 'CRT.M.030.Carteira_Existentes', 'SYS.Met_Carga' ) = 1 ); SubsetDestroy( 'CRT.M.030.Carteira_Existentes', 'SYS.Met_Carga' ); ENDIF;
