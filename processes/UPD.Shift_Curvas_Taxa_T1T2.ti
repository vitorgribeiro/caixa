#region Prolog

### B) Curvas CRT.015 para T1 e T2 (SAC + LA/WO), safras 2025/02..2026/12
sC15='CRT.015.Premissas_Safra'; sC30='CRT.030.Carteira_Existentes'; sAtCal='}ElementAttributes_ALL.D.Calendario';
nSaf=DIMSIZ('ALL.D.Safra');
i=1;
WHILE(i<=nSaf);
  sSaf=DIMNM('ALL.D.Safra',i);
  IF(ELLEV('ALL.D.Safra',sSaf)=0 & sSaf @>='2025/02' & sSaf @<='2026/12');
    p=1;
    WHILE(p<=DIMSIZ('ALL.D.Produto'));
      sPro=DIMNM('ALL.D.Produto',p);
      IF(ELLEV('ALL.D.Produto',sPro)=0);
        z=1;
        WHILE(z<=DIMSIZ('ALL.D.Prazo'));
          sPz=DIMNM('ALL.D.Prazo',z);
          IF(ELLEV('ALL.D.Prazo',sPz)=0);
            nP=ATTRN('ALL.D.Prazo',sPz,'Prazo');
            m=1;
            WHILE(m<=nP);
              sMob=TRIM(STR(m,5,0)); nRun=1/(nP-m+1);
              CellPutN(nRun ,sC15,sSaf,'T1',sPro,sPz,sMob,'% Runoff');
              CellPutN(0.003,sC15,sSaf,'T1',sPro,sPz,sMob,'% LA Full');
              CellPutN(0.002,sC15,sSaf,'T1',sPro,sPz,sMob,'% LA Parcial');
              CellPutN(0.0015,sC15,sSaf,'T1',sPro,sPz,sMob,'% WO');
              CellPutN(nRun ,sC15,sSaf,'T2',sPro,sPz,sMob,'% Runoff');
              CellPutN(0.003,sC15,sSaf,'T2',sPro,sPz,sMob,'% LA Full');
              CellPutN(0.002,sC15,sSaf,'T2',sPro,sPz,sMob,'% LA Parcial');
              CellPutN(0.0015,sC15,sSaf,'T2',sPro,sPz,sMob,'% WO');
              m=m+1;
            END;
          ENDIF;
          z=z+1;
        END;
      ENDIF;
      p=p+1;
    END;
  ENDIF;
  i=i+1;
END;

### A) % Taxa Media Carga na RE (safras 2025/02..2026/06), de 2026/07 em diante
i=1;
WHILE(i<=nSaf);
  sSaf=DIMNM('ALL.D.Safra',i);
  IF(ELLEV('ALL.D.Safra',sSaf)=0 & sSaf @>='2025/02' & sSaf @<='2026/06');
    p=1;
    WHILE(p<=DIMSIZ('ALL.D.Produto'));
      sPro=DIMNM('ALL.D.Produto',p);
      IF(ELLEV('ALL.D.Produto',sPro)=0);
        c=1;
        WHILE(c<=DIMSIZ('ALL.D.Canal'));
          sCan=DIMNM('ALL.D.Canal',c);
          IF(ELLEV('ALL.D.Canal',sCan)=0);
            z=1;
            WHILE(z<=DIMSIZ('ALL.D.Prazo'));
              sPz=DIMNM('ALL.D.Prazo',z);
              IF(ELLEV('ALL.D.Prazo',sPz)=0);
                t=1;
                WHILE(t<=DIMSIZ('ALL.D.Tipo_Pessoa'));
                  sTp=DIMNM('ALL.D.Tipo_Pessoa',t);
                  IF(ELLEV('ALL.D.Tipo_Pessoa',sTp)=0);
                    nTx=CellGetN(sC30,'2026/06',sSaf,'RE',sPro,sCan,sPz,sTp,'% Taxa Media Carga');
                    IF(nTx<>0);
                      nP=ATTRN('ALL.D.Prazo',sPz,'Prazo'); sM='2026/07'; k=1;
                      WHILE(k<=nP);
                        CellPutN(nTx,sC30,sM,sSaf,'RE',sPro,sCan,sPz,sTp,'% Taxa Media Carga');
                        sM=CellGetS(sAtCal,sM,'Next Period');
                        IF(sM @=''); k=nP+1; ELSE; k=k+1; ENDIF;
                      END;
                    ENDIF;
                  ENDIF;
                  t=t+1;
                END;
              ENDIF;
              z=z+1;
            END;
          ENDIF;
          c=c+1;
        END;
      ENDIF;
      p=p+1;
    END;
  ENDIF;
  i=i+1;
END;
#endregion