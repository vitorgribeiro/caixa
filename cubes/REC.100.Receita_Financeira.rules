SKIPCHECK;

['ALL.D.Versao':'RE'] = N: STET;

[] = N:
  IF( ELISANC( 'ALL.D.Versao', 'Versoes Dinamicas', !ALL.D.Versao ) <> 0
    , CONTINUE
    , STET
    );

[] = N:
  IF( DB( 'PRE.001.Premissas_Gerais', !ALL.D.Calendario, !ALL.D.Versao, 'Real x Orcado' ) @= 'Real'
    , ['ALL.D.Versao':'RE']
    , CONTINUE
    );

['REC.M.100.Receita_Financeira':'Saldo Medio'] = N:
  ( DB( 'CRT.050.Carteira_Consolidada', !ALL.D.Calendario, !ALL.D.Safra, !ALL.D.Versao, 'Total Carteira', !ALL.D.Produto, !ALL.D.Canal, 'Total Prazo', 'Saldo Inicial' )
  + DB( 'CRT.050.Carteira_Consolidada', !ALL.D.Calendario, !ALL.D.Safra, !ALL.D.Versao, 'Total Carteira', !ALL.D.Produto, !ALL.D.Canal, 'Total Prazo', 'Saldo Final' )
  ) \ 2;

['REC.M.100.Receita_Financeira':'(+) Juros Carteira'] = N:
  DB( 'CRT.050.Carteira_Consolidada', !ALL.D.Calendario, !ALL.D.Safra, !ALL.D.Versao, 'Total Carteira', !ALL.D.Produto, !ALL.D.Canal, 'Total Prazo', '(+) Juros' );


# INICIO DE REGRA TEMPORÁRIA PARA EVENTO DE BANCOS 28/07/2026 (DEMO DE CAPITAL) - APAGAR DEPOIS

['REC.M.100.Receita_Financeira':'(+) Juros Carteira'
 , 'ALL.D.Calendario':'ALL.D.Calendario':'2026'] = C:
  
  (  ['ALL.D.Calendario':'ALL.D.Calendario':'2026/01']
   + ['ALL.D.Calendario':'ALL.D.Calendario':'2026/02']
   + ['ALL.D.Calendario':'ALL.D.Calendario':'2026/03']
