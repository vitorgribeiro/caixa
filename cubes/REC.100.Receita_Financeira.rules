# TERMINO DE REGRA TEMPORÁRIA PARA EVENTO DE BANCOS 28/07/2026 (DEMO DE CAPITAL) - APAGAR DEPOIS


['REC.M.100.Receita_Financeira':'(-) Custo Funding'] = N:
  - ( DB( 'CRT.010.Premissas_Calendario', !ALL.D.Calendario, !ALL.D.Versao, !ALL.D.Produto, '% Custo Funding' )
      * ['REC.M.100.Receita_Financeira':'Saldo Medio']
    );


FEEDERS;

['ALL.D.Versao':'Versoes Dinamicas','REC.M.100.Receita_Financeira':'Saldo Medio'] =>
    ['REC.M.100.Receita_Financeira':'(-) Custo Funding']
  , ['REC.M.100.Receita_Financeira':'(+) Juros Carteira'];
