SKIPCHECK;

['ALL.D.Versao':'RE'] = N: STET;

[] = N:
  IF( ELISANC( 'ALL.D.Versao', 'Versoes Dinamicas', !ALL.D.Versao ) <> 0
    , CONTINUE
    , STET
    );

[] = N:
  IF( DB( 'PRE.001.Premissas_Gerais', !ALL.D.Calendario, !ALL.D.Versao, 'Real x Orcado' ) @= 'Real'
    , ['ALL.D.Versao':'RE']
    , CONTINUE
    );

['CRT.M.040.Carteira_Novos':'Valor Financiado'] = N:
  IF( !ALL.D.Calendario @= !ALL.D.Safra
    , DB( 'COM.020.Producao', !ALL.D.Calendario, !ALL.D.Versao, !ALL.D.Produto, !ALL.D.Segmento, 'Valor Financiado Total' )
    , 0
    );

['CRT.M.040.Carteira_Novos':'Parcelas Remanecentes'] = N:
  IF( !ALL.D.Calendario @= !ALL.D.Safra
    , ROUND(DB( 'COM.020.Producao', !ALL.D.Calendario, !ALL.D.Versao, !ALL.D.Produto,  !ALL.D.Segmento, 'Prazo Médio' ))+1
    , CONTINUE
    );


['CRT.M.040.Carteira_Novos':'Parcelas Remanecentes'] = N:
  IF( !ALL.D.Calendario @> !ALL.D.Safra
    , IF( DB( 'CRT.040.Carteira_Novos', DB( '}ElementAttributes_ALL.D.Calendario', !ALL.D.Calendario, 'Previous Period' ), !ALL.D.Safra, !ALL.D.Versao, !ALL.D.Produto, !ALL.D.Segmento, 'Parcelas Remanecentes' )>0
          ,  DB( 'CRT.040.Carteira_Novos', DB( '}ElementAttributes_ALL.D.Calendario', !ALL.D.Calendario, 'Previous Period' ), !ALL.D.Safra, !ALL.D.Versao, !ALL.D.Produto, !ALL.D.Segmento, 'Parcelas Remanecentes' )- 1
          , 0 )
    , CONTINUE
    );


['CRT.M.040.Carteira_Novos':'Volume'] = N:
  IF( !ALL.D.Calendario @= !ALL.D.Safra
    , DB( 'COM.020.Producao', !ALL.D.Calendario, !ALL.D.Versao, !ALL.D.Produto,  !ALL.D.Segmento, 'Qtd Contratos' )
    , 0
    );

['CRT.M.040.Carteira_Novos':'Saldo Inicial'] = N:
  DB( 'CRT.040.Carteira_Novos', DB( '}ElementAttributes_ALL.D.Calendario', !ALL.D.Calendario, 'Previous Period' ), !ALL.D.Safra, !ALL.D.Versao, !ALL.D.Produto, !ALL.D.Segmento, 'Saldo Final' );

['CRT.M.040.Carteira_Novos':'(-) Amortizacao'] = N:
  - ( ['CRT.M.040.Carteira_Novos':'Saldo Inicial']
          + ['CRT.M.040.Carteira_Novos':'CRT.M.040.Carteira_Novos':'(-) LA Total']
          + ['CRT.M.040.Carteira_Novos':'(+) Juros']
          + ['CRT.M.040.Carteira_Novos':'(-) WO']
        )
  \
  ['CRT.M.040.Carteira_Novos':'Parcelas Remanecentes']
    ;

['CRT.M.040.Carteira_Novos':'(+) Juros'] = N:
  ( ( 1 + DB( 'COM.020.Producao', !ALL.D.Safra, !ALL.D.Versao, !ALL.D.Produto,  !ALL.D.Segmento, '% Taxa' ) )
    ^ ( DB( 'PRE.001.Premissas_Gerais', !ALL.D.Calendario, !ALL.D.Versao, 'Dias Corridos' ) \ 30 ) - 1
  )
  * ['CRT.M.040.Carteira_Novos':'Saldo Inicial'];

['CRT.M.040.Carteira_Novos':'(-) LA Full'] = N:
  - ( ['CRT.M.040.Carteira_Novos':'Saldo Inicial']
          * DB( 'CRT.015.Premissas_Safra', !ALL.D.Calendario, !ALL.D.Versao, !ALL.D.Produto,  '% LA Full' )
        );

['CRT.M.040.Carteira_Novos':'(-) LA Parcial'] = N:
   - ( ['CRT.M.040.Carteira_Novos':'Saldo Inicial']
          * DB( 'CRT.015.Premissas_Safra', !ALL.D.Calendario, !ALL.D.Versao, !ALL.D.Produto, '% LA Parcial' )
        );

['CRT.M.040.Carteira_Novos':'(-) WO'] = N:
  - ( ['CRT.M.040.Carteira_Novos':'Saldo Inicial']
              * DB( 'CRT.015.Premissas_Safra', !ALL.D.Calendario, !ALL.D.Versao, !ALL.D.Produto,  '% WO' )
            );

['CRT.M.040.Carteira_Novos':'Saldo Final'] = N:
    ['CRT.M.040.Carteira_Novos':'Saldo Inicial']
  + ['CRT.M.040.Carteira_Novos':'Valor Financiado']
  + ['CRT.M.040.Carteira_Novos':'(-) Amortizacao']
  + ['CRT.M.040.Carteira_Novos':'(-) LA Total']
  + ['CRT.M.040.Carteira_Novos':'(-) WO']
  +['CRT.M.040.Carteira_Novos':'(+) Juros'];


FEEDERS;

['ALL.D.Versao':'Versoes Dinamicas','CRT.M.040.Carteira_Novos':'Valor Financiado'] =>
    ['CRT.M.040.Carteira_Novos':'SYS.MOB']
  , ['CRT.M.040.Carteira_Novos':'Saldo Final']
  , ['CRT.M.040.Carteira_Novos':'Volume'];

['ALL.D.Versao':'Versoes Dinamicas','CRT.M.040.Carteira_Novos':'Saldo Final'] =>
    DB( 'CRT.040.Carteira_Novos', DB( '}ElementAttributes_ALL.D.Calendario', !ALL.D.Calendario, 'Next Period' ), !ALL.D.Safra, !ALL.D.Versao, !ALL.D.Produto, !ALL.D.Segmento, 'Saldo Inicial' )
  , DB( 'CRT.040.Carteira_Novos', DB( '}ElementAttributes_ALL.D.Calendario', !ALL.D.Calendario, 'Next Period' ), !ALL.D.Safra, !ALL.D.Versao, !ALL.D.Produto, !ALL.D.Segmento, 'SYS.MOB' )
  , DB( 'CRT.040.Carteira_Novos', DB( '}ElementAttributes_ALL.D.Calendario', !ALL.D.Calendario, 'Next Period' ), !ALL.D.Safra, !ALL.D.Versao, !ALL.D.Produto, !ALL.D.Segmento, 'Saldo Final' );

['ALL.D.Versao':'Versoes Dinamicas','CRT.M.040.Carteira_Novos':'Saldo Inicial'] =>
    ['CRT.M.040.Carteira_Novos':'(+) Juros']
  , ['CRT.M.040.Carteira_Novos':'(-) Amortizacao']
  , ['CRT.M.040.Carteira_Novos':'(-) LA Full']
  , ['CRT.M.040.Carteira_Novos':'(-) LA Parcial']
  , ['CRT.M.040.Carteira_Novos':'(-) WO'];

# Feeders externos - consolidada (todas as metricas puxadas por CRT.050) e receita
['ALL.D.Versao':'Versoes Dinamicas','CRT.M.040.Carteira_Novos':'Saldo Final'] =>
    DB( 'CRT.050.Carteira_Consolidada', !ALL.D.Calendario, !ALL.D.Safra, !ALL.D.Versao, 'Novos', !ALL.D.Produto, 'Saldo Final' );

['ALL.D.Versao':'Versoes Dinamicas','CRT.M.040.Carteira_Novos':'Saldo Inicial'] =>
    DB( 'CRT.050.Carteira_Consolidada', !ALL.D.Calendario, !ALL.D.Safra, !ALL.D.Versao, 'Novos', !ALL.D.Produto, 'Saldo Inicial' );

['ALL.D.Versao':'Versoes Dinamicas','CRT.M.040.Carteira_Novos':'(+) Juros'] =>
    DB( 'CRT.050.Carteira_Consolidada', !ALL.D.Calendario, !ALL.D.Safra, !ALL.D.Versao, 'Novos', !ALL.D.Produto, '(+) Juros' );

['ALL.D.Versao':'Versoes Dinamicas','CRT.M.040.Carteira_Novos':'(-) Amortizacao'] =>
    DB( 'CRT.050.Carteira_Consolidada', !ALL.D.Calendario, !ALL.D.Safra, !ALL.D.Versao, 'Novos', !ALL.D.Produto, '(-) Amortizacao' );

['ALL.D.Versao':'Versoes Dinamicas','CRT.M.040.Carteira_Novos':'(-) LA Full'] =>
    DB( 'CRT.050.Carteira_Consolidada', !ALL.D.Calendario, !ALL.D.Safra, !ALL.D.Versao, 'Novos', !ALL.D.Produto, '(-) LA Total' );

['ALL.D.Versao':'Versoes Dinamicas','CRT.M.040.Carteira_Novos':'(-) LA Parcial'] =>
    DB( 'CRT.050.Carteira_Consolidada', !ALL.D.Calendario, !ALL.D.Safra, !ALL.D.Versao, 'Novos', !ALL.D.Produto, '(-) LA Total' );

['ALL.D.Versao':'Versoes Dinamicas','CRT.M.040.Carteira_Novos':'(-) WO'] =>
    DB( 'CRT.050.Carteira_Consolidada', !ALL.D.Calendario, !ALL.D.Safra, !ALL.D.Versao, 'Novos', !ALL.D.Produto, '(-) WO' );
