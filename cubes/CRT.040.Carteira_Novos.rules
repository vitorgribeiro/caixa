SKIPCHECK;

['ALL.D.Versao':'RE'] = N: STET;

[] = N:
  IF( ELISANC( 'ALL.D.Versao', 'Versoes Dinamicas', !ALL.D.Versao ) <> 0
    , CONTINUE
    , STET
    );

[] = N:
  IF( DB( 'PRE.001.Premissas_Gerais', !ALL.D.Calendario, !ALL.D.Versao, 'Real x Orcado' ) @= 'Real'
    , ['ALL.D.Versao':'RE']
    , CONTINUE
    );

['CRT.M.040.Carteira_Novos':'Valor Financiado'] = N:
  IF( !ALL.D.Calendario @= !ALL.D.Safra
    , DB( 'COM.020.Producao', !ALL.D.Calendario, !ALL.D.Versao, !ALL.D.Produto, !ALL.D.Canal, !ALL.D.Prazo, !ALL.D.Tipo_Pessoa, 'Valor Financiado Total' )
    , 0
    );

['CRT.M.040.Carteira_Novos':'Volume'] = N:
  IF( !ALL.D.Calendario @= !ALL.D.Safra
    , DB( 'COM.020.Producao', !ALL.D.Calendario, !ALL.D.Versao, !ALL.D.Produto, !ALL.D.Canal, !ALL.D.Prazo, !ALL.D.Tipo_Pessoa, 'Qtd Contratos' )
    , 0
    );

['CRT.M.040.Carteira_Novos':'SYS.MOB'] = N:
  IF( !ALL.D.Calendario @= !ALL.D.Safra
    , 1
    , IF( DB( 'CRT.040.Carteira_Novos', DB( '}ElementAttributes_ALL.D.Calendario', !ALL.D.Calendario, 'Previous Period' ), !ALL.D.Safra, !ALL.D.Versao, !ALL.D.Produto, !ALL.D.Canal, !ALL.D.Prazo, !ALL.D.Tipo_Pessoa, 'SYS.MOB' ) >= 1
        & DB( 'CRT.040.Carteira_Novos', DB( '}ElementAttributes_ALL.D.Calendario', !ALL.D.Calendario, 'Previous Period' ), !ALL.D.Safra, !ALL.D.Versao, !ALL.D.Produto, !ALL.D.Canal, !ALL.D.Prazo, !ALL.D.Tipo_Pessoa, 'SYS.MOB' ) < ATTRN( 'ALL.D.Prazo', !ALL.D.Prazo, 'Prazo' )
      , DB( 'CRT.040.Carteira_Novos', DB( '}ElementAttributes_ALL.D.Calendario', !ALL.D.Calendario, 'Previous Period' ), !ALL.D.Safra, !ALL.D.Versao, !ALL.D.Produto, !ALL.D.Canal, !ALL.D.Prazo, !ALL.D.Tipo_Pessoa, 'SYS.MOB' ) + 1
      , 0
      )
    );

['CRT.M.040.Carteira_Novos':'Saldo Inicial'] = N:
  DB( 'CRT.040.Carteira_Novos', DB( '}ElementAttributes_ALL.D.Calendario', !ALL.D.Calendario, 'Previous Period' ), !ALL.D.Safra, !ALL.D.Versao, !ALL.D.Produto, !ALL.D.Canal, !ALL.D.Prazo, !ALL.D.Tipo_Pessoa, 'Saldo Final' );

['CRT.M.040.Carteira_Novos':'(-) Amortizacao'] = N:
  IF( ['CRT.M.040.Carteira_Novos':'SYS.MOB'] = 0
    , 0
    , - ( ['CRT.M.040.Carteira_Novos':'Saldo Inicial']
          * DB( 'CRT.015.Premissas_Safra', !ALL.D.Safra, !ALL.D.Versao, !ALL.D.Produto, !ALL.D.Prazo, TRIM( STR( ['CRT.M.040.Carteira_Novos':'SYS.MOB'], 3, 0 ) ), '% Runoff' )
        )
    );

['CRT.M.040.Carteira_Novos':'(+) Juros'] = N:
  ( ( 1 + DB( 'CRT.010.Premissas_Calendario', !ALL.D.Calendario, !ALL.D.Versao, !ALL.D.Produto, '% Taxa Cliente' ) )
    ^ ( DB( 'PRE.001.Premissas_Gerais', !ALL.D.Calendario, !ALL.D.Versao, 'Dias Corridos' ) \ 30 ) - 1
  )
  * ['CRT.M.040.Carteira_Novos':'Saldo Inicial'];

['CRT.M.040.Carteira_Novos':'(-) LA Full'] = N:
  IF( ['CRT.M.040.Carteira_Novos':'SYS.MOB'] = 0
    , 0
    , - ( ['CRT.M.040.Carteira_Novos':'Saldo Inicial']
          * DB( 'CRT.015.Premissas_Safra', !ALL.D.Safra, !ALL.D.Versao, !ALL.D.Produto, !ALL.D.Prazo, TRIM( STR( ['CRT.M.040.Carteira_Novos':'SYS.MOB'], 3, 0 ) ), '% LA Full' )
        )
    );

['CRT.M.040.Carteira_Novos':'(-) LA Parcial'] = N:
  IF( ['CRT.M.040.Carteira_Novos':'SYS.MOB'] = 0
    , 0
    , - ( ['CRT.M.040.Carteira_Novos':'Saldo Inicial']
          * DB( 'CRT.015.Premissas_Safra', !ALL.D.Safra, !ALL.D.Versao, !ALL.D.Produto, !ALL.D.Prazo, TRIM( STR( ['CRT.M.040.Carteira_Novos':'SYS.MOB'], 3, 0 ) ), '% LA Parcial' )
        )
    );

['CRT.M.040.Carteira_Novos':'(-) WO'] = N:
  IF( ['CRT.M.040.Carteira_Novos':'SYS.MOB'] = 0
    , 0
    , IF( ['CRT.M.040.Carteira_Novos':'SYS.MOB'] = ATTRN( 'ALL.D.Prazo', !ALL.D.Prazo, 'Prazo' )
        , - ( ['CRT.M.040.Carteira_Novos':'Saldo Inicial']
              + ['CRT.M.040.Carteira_Novos':'(-) Amortizacao']
              + ['CRT.M.040.Carteira_Novos':'(-) LA Total']
            )
        , - ( ['CRT.M.040.Carteira_Novos':'Saldo Inicial']
              * DB( 'CRT.015.Premissas_Safra', !ALL.D.Safra, !ALL.D.Versao, !ALL.D.Produto, !ALL.D.Prazo, TRIM( STR( ['CRT.M.040.Carteira_Novos':'SYS.MOB'], 3, 0 ) ), '% WO' )
            )
        )
    );

['CRT.M.040.Carteira_Novos':'Saldo Final'] = N:
    ['CRT.M.040.Carteira_Novos':'Saldo Inicial']
  + ['CRT.M.040.Carteira_Novos':'Valor Financiado']
  + ['CRT.M.040.Carteira_Novos':'(-) Amortizacao']
  + ['CRT.M.040.Carteira_Novos':'(-) LA Total']
  + ['CRT.M.040.Carteira_Novos':'(-) WO'];


FEEDERS;

['ALL.D.Versao':'Versoes Dinamicas','CRT.M.040.Carteira_Novos':'Valor Financiado'] =>
    ['CRT.M.040.Carteira_Novos':'SYS.MOB']
  , ['CRT.M.040.Carteira_Novos':'Saldo Final']
  , ['CRT.M.040.Carteira_Novos':'Volume'];

['ALL.D.Versao':'Versoes Dinamicas','CRT.M.040.Carteira_Novos':'Saldo Final'] =>
    DB( 'CRT.040.Carteira_Novos', DB( '}ElementAttributes_ALL.D.Calendario', !ALL.D.Calendario, 'Next Period' ), !ALL.D.Safra, !ALL.D.Versao, !ALL.D.Produto, !ALL.D.Canal, !ALL.D.Prazo, !ALL.D.Tipo_Pessoa, 'Saldo Inicial' )
  , DB( 'CRT.040.Carteira_Novos', DB( '}ElementAttributes_ALL.D.Calendario', !ALL.D.Calendario, 'Next Period' ), !ALL.D.Safra, !ALL.D.Versao, !ALL.D.Produto, !ALL.D.Canal, !ALL.D.Prazo, !ALL.D.Tipo_Pessoa, 'SYS.MOB' )
  , DB( 'CRT.040.Carteira_Novos', DB( '}ElementAttributes_ALL.D.Calendario', !ALL.D.Calendario, 'Next Period' ), !ALL.D.Safra, !ALL.D.Versao, !ALL.D.Produto, !ALL.D.Canal, !ALL.D.Prazo, !ALL.D.Tipo_Pessoa, 'Saldo Final' );

['ALL.D.Versao':'Versoes Dinamicas','CRT.M.040.Carteira_Novos':'Saldo Inicial'] =>
    ['CRT.M.040.Carteira_Novos':'(+) Juros']
  , ['CRT.M.040.Carteira_Novos':'(-) Amortizacao']
  , ['CRT.M.040.Carteira_Novos':'(-) LA Full']
  , ['CRT.M.040.Carteira_Novos':'(-) LA Parcial']
  , ['CRT.M.040.Carteira_Novos':'(-) WO'];

# Feeders externos - consolidada (todas as metricas puxadas por CRT.050) e receita
['ALL.D.Versao':'Versoes Dinamicas','CRT.M.040.Carteira_Novos':'Saldo Final'] =>
    DB( 'CRT.050.Carteira_Consolidada', !ALL.D.Calendario, !ALL.D.Safra, !ALL.D.Versao, 'Novos', !ALL.D.Produto, !ALL.D.Canal, !ALL.D.Prazo, 'Saldo Final' )
  , DB( 'REC.100.Receita_Financeira', !ALL.D.Calendario, !ALL.D.Safra, !ALL.D.Versao, !ALL.D.Produto, !ALL.D.Canal, 'Saldo Medio' );

['ALL.D.Versao':'Versoes Dinamicas','CRT.M.040.Carteira_Novos':'Saldo Inicial'] =>
    DB( 'CRT.050.Carteira_Consolidada', !ALL.D.Calendario, !ALL.D.Safra, !ALL.D.Versao, 'Novos', !ALL.D.Produto, !ALL.D.Canal, !ALL.D.Prazo, 'Saldo Inicial' );

['ALL.D.Versao':'Versoes Dinamicas','CRT.M.040.Carteira_Novos':'(+) Juros'] =>
    DB( 'CRT.050.Carteira_Consolidada', !ALL.D.Calendario, !ALL.D.Safra, !ALL.D.Versao, 'Novos', !ALL.D.Produto, !ALL.D.Canal, !ALL.D.Prazo, '(+) Juros' );

['ALL.D.Versao':'Versoes Dinamicas','CRT.M.040.Carteira_Novos':'(-) Amortizacao'] =>
    DB( 'CRT.050.Carteira_Consolidada', !ALL.D.Calendario, !ALL.D.Safra, !ALL.D.Versao, 'Novos', !ALL.D.Produto, !ALL.D.Canal, !ALL.D.Prazo, '(-) Amortizacao' );

['ALL.D.Versao':'Versoes Dinamicas','CRT.M.040.Carteira_Novos':'(-) LA Full'] =>
    DB( 'CRT.050.Carteira_Consolidada', !ALL.D.Calendario, !ALL.D.Safra, !ALL.D.Versao, 'Novos', !ALL.D.Produto, !ALL.D.Canal, !ALL.D.Prazo, '(-) LA Total' );

['ALL.D.Versao':'Versoes Dinamicas','CRT.M.040.Carteira_Novos':'(-) LA Parcial'] =>
    DB( 'CRT.050.Carteira_Consolidada', !ALL.D.Calendario, !ALL.D.Safra, !ALL.D.Versao, 'Novos', !ALL.D.Produto, !ALL.D.Canal, !ALL.D.Prazo, '(-) LA Total' );

['ALL.D.Versao':'Versoes Dinamicas','CRT.M.040.Carteira_Novos':'(-) WO'] =>
    DB( 'CRT.050.Carteira_Consolidada', !ALL.D.Calendario, !ALL.D.Safra, !ALL.D.Versao, 'Novos', !ALL.D.Produto, !ALL.D.Canal, !ALL.D.Prazo, '(-) WO' );
