SKIPCHECK;

['ALL.D.Versao':'RE'] = N: STET;

[] = N:
  IF( ELISANC( 'ALL.D.Versao', 'Versoes Dinamicas', !ALL.D.Versao ) <> 0
    , CONTINUE
    , STET
    );

[] = N:
  IF( DB( 'PRE.001.Premissas_Gerais', !ALL.D.Calendario, !ALL.D.Versao, 'Real x Orcado' ) @= 'Real'
    , ['ALL.D.Versao':'RE']
    , CONTINUE
    );

['CRT.M.030.Carteira_Existentes':{'% Taxa','Parcelas Remanescentes'}] = C:
  IF( ELLEV( 'ALL.D.Safra', !ALL.D.Safra ) > 0, 0, CONTINUE );


['CRT.M.030.Carteira_Existentes':'Saldo Inicial'] = N:
  IF( DB( 'PRE.001.Premissas_Gerais', DB( '}ElementAttributes_ALL.D.Calendario', !ALL.D.Calendario, 'Previous Period' ), !ALL.D.Versao, 'Real x Orcado' ) @= 'Real'
    , DB( 'CRT.030.Carteira_Existentes', DB( '}ElementAttributes_ALL.D.Calendario', !ALL.D.Calendario, 'Previous Period' ), !ALL.D.Safra, 'RE', !ALL.D.Produto, !ALL.D.Segmento, 'Saldo Carga' )
    , DB( 'CRT.030.Carteira_Existentes', DB( '}ElementAttributes_ALL.D.Calendario', !ALL.D.Calendario, 'Previous Period' ), !ALL.D.Safra, !ALL.D.Versao, !ALL.D.Produto, !ALL.D.Segmento, 'Saldo Final' )
    );


['CRT.M.030.Carteira_Existentes':'Parcelas Remanescentes'] = N:
  IF( DB( 'PRE.001.Premissas_Gerais', DB( '}ElementAttributes_ALL.D.Calendario', !ALL.D.Calendario, 'Previous Period' ), !ALL.D.Versao, 'Real x Orcado' ) @= 'Real'
    , IF(DB( 'CRT.030.Carteira_Existentes', DB( '}ElementAttributes_ALL.D.Calendario', !ALL.D.Calendario, 'Previous Period' ), !ALL.D.Safra, 'RE', !ALL.D.Produto, !ALL.D.Segmento, 'Parcelas Remanescentes' )>0
        , ROUND(DB( 'CRT.030.Carteira_Existentes', DB( '}ElementAttributes_ALL.D.Calendario', !ALL.D.Calendario, 'Previous Period' ), !ALL.D.Safra, 'RE', !ALL.D.Produto, !ALL.D.Segmento, 'Parcelas Remanescentes' )) 
        , 0 )
    , IF(DB( 'CRT.030.Carteira_Existentes', DB( '}ElementAttributes_ALL.D.Calendario', !ALL.D.Calendario, 'Previous Period' ), !ALL.D.Safra, !ALL.D.Versao, !ALL.D.Produto, !ALL.D.Segmento, 'Parcelas Remanescentes' )>0
       , DB( 'CRT.030.Carteira_Existentes', DB( '}ElementAttributes_ALL.D.Calendario', !ALL.D.Calendario, 'Previous Period' ), !ALL.D.Safra, !ALL.D.Versao, !ALL.D.Produto, !ALL.D.Segmento, 'Parcelas Remanescentes' ) - 1
       , 0 
    )
    );


['CRT.M.030.Carteira_Existentes':'(-) Amortizacao'] = N:
     - ( ['CRT.M.030.Carteira_Existentes':'Saldo Inicial']
          + ['CRT.M.030.Carteira_Existentes':'CRT.M.030.Carteira_Existentes':'(-) LA Total']
          + ['CRT.M.030.Carteira_Existentes':'(-) WO']
          + ['CRT.M.030.Carteira_Existentes':'(+) Juros']
        )
    \
  ['Parcelas Remanescentes'];

['CRT.M.030.Carteira_Existentes':'(-) LA Full'] = N:
  IF( ['CRT.M.030.Carteira_Existentes':'SYS.MOB'] = 0
    , 0
    , - ( ['CRT.M.030.Carteira_Existentes':'Saldo Inicial']
          * DB( 'CRT.015.Premissas_Safra', !ALL.D.Calendario, !ALL.D.Versao, !ALL.D.Produto,  '% LA Full' )
        )
    );

['CRT.M.030.Carteira_Existentes':'(-) LA Parcial'] = N:
  IF( ['CRT.M.030.Carteira_Existentes':'SYS.MOB'] = 0
    , 0
    , - ( ['CRT.M.030.Carteira_Existentes':'Saldo Inicial']
          * DB( 'CRT.015.Premissas_Safra', !ALL.D.Calendario, !ALL.D.Versao, !ALL.D.Produto, '% LA Parcial' )
        )
    );

['CRT.M.030.Carteira_Existentes':'(-) WO'] = N:
  - ( ['CRT.M.030.Carteira_Existentes':'Saldo Inicial']
              * DB( 'CRT.015.Premissas_Safra', !ALL.D.Calendario, !ALL.D.Versao, !ALL.D.Produto, '% WO' )
            );

['CRT.M.030.Carteira_Existentes':'(+) Juros'] = N:
  ( ( 1 + DB( 'CRT.030.Carteira_Existentes', !ALL.D.Safra, !ALL.D.Safra, 'RE', !ALL.D.Produto, !ALL.D.Segmento, '% Taxa' ) )
    ^ ( DB( 'PRE.001.Premissas_Gerais', !ALL.D.Calendario, !ALL.D.Versao, 'Dias Corridos' ) \ 30 ) - 1
  )
  * ['CRT.M.030.Carteira_Existentes':'Saldo Inicial'];

['CRT.M.030.Carteira_Existentes':'Saldo Final'] = N:
    ['CRT.M.030.Carteira_Existentes':'Saldo Inicial']
  + ['CRT.M.030.Carteira_Existentes':'(-) Amortizacao']
  + ['CRT.M.030.Carteira_Existentes':'(-) LA Total']
  + ['CRT.M.030.Carteira_Existentes':'(+) Juros']
  + ['CRT.M.030.Carteira_Existentes':'(-) WO'];


FEEDERS;

['ALL.D.Versao':'RE','CRT.M.030.Carteira_Existentes':'Saldo Carga'] =>
    DB( 'CRT.030.Carteira_Existentes', DB( '}ElementAttributes_ALL.D.Calendario', !ALL.D.Calendario, 'Next Period' ), !ALL.D.Safra, 'Versoes Dinamicas', !ALL.D.Produto, !ALL.D.Segmento, 'Saldo Inicial' )
  , DB( 'CRT.030.Carteira_Existentes', DB( '}ElementAttributes_ALL.D.Calendario', !ALL.D.Calendario, 'Next Period' ), !ALL.D.Safra, 'Versoes Dinamicas', !ALL.D.Produto, !ALL.D.Segmento, 'SYS.MOB' )
  , DB( 'CRT.030.Carteira_Existentes', DB( '}ElementAttributes_ALL.D.Calendario', !ALL.D.Calendario, 'Next Period' ), !ALL.D.Safra, 'Versoes Dinamicas', !ALL.D.Produto, !ALL.D.Segmento, 'Saldo Final' );

['ALL.D.Versao':'Versoes Dinamicas','CRT.M.030.Carteira_Existentes':'Saldo Final'] =>
    DB( 'CRT.030.Carteira_Existentes', DB( '}ElementAttributes_ALL.D.Calendario', !ALL.D.Calendario, 'Next Period' ), !ALL.D.Safra, !ALL.D.Versao, !ALL.D.Produto, !ALL.D.Segmento, 'Saldo Inicial' )
  , DB( 'CRT.030.Carteira_Existentes', DB( '}ElementAttributes_ALL.D.Calendario', !ALL.D.Calendario, 'Next Period' ), !ALL.D.Safra, !ALL.D.Versao, !ALL.D.Produto, !ALL.D.Segmento, 'SYS.MOB' )
  , DB( 'CRT.030.Carteira_Existentes', DB( '}ElementAttributes_ALL.D.Calendario', !ALL.D.Calendario, 'Next Period' ), !ALL.D.Safra, !ALL.D.Versao, !ALL.D.Produto, !ALL.D.Segmento, 'Saldo Final' );

['ALL.D.Versao':'Versoes Dinamicas','CRT.M.030.Carteira_Existentes':'Saldo Inicial'] =>
    ['CRT.M.030.Carteira_Existentes':'(+) Juros']
  , ['CRT.M.030.Carteira_Existentes':'(-) Amortizacao']
  , ['CRT.M.030.Carteira_Existentes':'(-) LA Full']
  , ['CRT.M.030.Carteira_Existentes':'(-) LA Parcial']
  , ['CRT.M.030.Carteira_Existentes':'(-) WO'];

# Feeders externos - consolidada (todas as metricas puxadas por CRT.050) e receita
['ALL.D.Versao':'Versoes Dinamicas','CRT.M.030.Carteira_Existentes':'Saldo Final'] =>
    DB( 'CRT.050.Carteira_Consolidada', !ALL.D.Calendario, !ALL.D.Safra, !ALL.D.Versao, 'Existentes', !ALL.D.Produto, 'Saldo Final' );

['ALL.D.Versao':'Versoes Dinamicas','CRT.M.030.Carteira_Existentes':'Saldo Inicial'] =>
    DB( 'CRT.050.Carteira_Consolidada', !ALL.D.Calendario, !ALL.D.Safra, !ALL.D.Versao, 'Existentes', !ALL.D.Produto, 'Saldo Inicial' );

['ALL.D.Versao':'Versoes Dinamicas','CRT.M.030.Carteira_Existentes':'(+) Juros'] =>
    DB( 'CRT.050.Carteira_Consolidada', !ALL.D.Calendario, !ALL.D.Safra, !ALL.D.Versao, 'Existentes', !ALL.D.Produto,  '(+) Juros' );

['ALL.D.Versao':'Versoes Dinamicas','CRT.M.030.Carteira_Existentes':'(-) Amortizacao'] =>
    DB( 'CRT.050.Carteira_Consolidada', !ALL.D.Calendario, !ALL.D.Safra, !ALL.D.Versao, 'Existentes', !ALL.D.Produto, '(-) Amortizacao' );

['ALL.D.Versao':'Versoes Dinamicas','CRT.M.030.Carteira_Existentes':'(-) LA Full'] =>
    DB( 'CRT.050.Carteira_Consolidada', !ALL.D.Calendario, !ALL.D.Safra, !ALL.D.Versao, 'Existentes', !ALL.D.Produto, '(-) LA Total' );

['ALL.D.Versao':'Versoes Dinamicas','CRT.M.030.Carteira_Existentes':'(-) LA Parcial'] =>
    DB( 'CRT.050.Carteira_Consolidada', !ALL.D.Calendario, !ALL.D.Safra, !ALL.D.Versao, 'Existentes', !ALL.D.Produto, '(-) LA Total' );

['ALL.D.Versao':'Versoes Dinamicas','CRT.M.030.Carteira_Existentes':'(-) WO'] =>
    DB( 'CRT.050.Carteira_Consolidada', !ALL.D.Calendario, !ALL.D.Safra, !ALL.D.Versao, 'Existentes', !ALL.D.Produto,  '(-) WO' );


# FDR-01 | alimenta RGR-01 do cubo COM.020.Producao
# FeederExterno
# Só a célula de originação (Calendario = Safra) alimenta; o resto da carteira não.
['ALL.D.Versao':'RE', 'CRT.M.030.Carteira_Existentes':'Saldo Carga'] =>
  DB( IF( !ALL.D.Calendario @= !ALL.D.Safra, 'COM.020.Producao', '' )
    , !ALL.D.Safra
    , 'RE'
    , !ALL.D.Produto
    , !ALL.D.Segmento
    , 'Valor Financiado Total' );

# FDR-02 | alimenta RGR-02 do cubo COM.020.Producao
# FeederExterno
['ALL.D.Versao':'RE', 'CRT.M.030.Carteira_Existentes':'% Taxa'] =>
  DB( IF( !ALL.D.Calendario @= !ALL.D.Safra, 'COM.020.Producao', '' )
    , !ALL.D.Safra
    , 'RE'
    , !ALL.D.Produto
    , !ALL.D.Segmento
    , '% Taxa' );

['ALL.D.Versao':'RE', 'CRT.M.030.Carteira_Existentes':'Parcelas Remanescentes'] =>
  DB( IF( !ALL.D.Calendario @= !ALL.D.Safra, 'COM.020.Producao', '' )
    , !ALL.D.Safra
    , 'RE'
    , !ALL.D.Produto
    , !ALL.D.Segmento
    , 'Prazo Médio' );


['ALL.D.Versao':'RE', 'CRT.M.030.Carteira_Existentes':'Volume'] =>
  DB( IF( !ALL.D.Calendario @= !ALL.D.Safra, 'COM.020.Producao', '' )
    , !ALL.D.Safra
    , 'RE'
    , !ALL.D.Produto
    , !ALL.D.Segmento
    , 'Qtd Contratos' );

