SKIPCHECK;

['ALL.D.Versao':'RE'] = N: STET;

[] = N:
  IF( ELISANC( 'ALL.D.Versao', 'Versoes Dinamicas', !ALL.D.Versao ) <> 0
    , CONTINUE
    , STET
    );

[] = N:
  IF( DB( 'PRE.001.Premissas_Gerais', !ALL.D.Calendario, !ALL.D.Versao, 'Real x Orcado' ) @= 'Real'
    , ['ALL.D.Versao':'RE']
    , CONTINUE
    );

['CRT.M.030.Carteira_Existentes':{'% Taxa Media Carga','Parcelas Remanescentes'}] = C:
  IF( ELLEV( 'ALL.D.Safra', !ALL.D.Safra ) > 0, 0, CONTINUE );

['CRT.M.030.Carteira_Existentes':'SYS.MOB'] = N:
  IF( DB( 'PRE.001.Premissas_Gerais', DB( '}ElementAttributes_ALL.D.Calendario', !ALL.D.Calendario, 'Previous Period' ), !ALL.D.Versao, 'Real x Orcado' ) @= 'Real'
    , IF( DB( 'CRT.030.Carteira_Existentes', DB( '}ElementAttributes_ALL.D.Calendario', !ALL.D.Calendario, 'Previous Period' ), !ALL.D.Safra, 'RE', !ALL.D.Produto, !ALL.D.Canal, !ALL.D.Prazo, !ALL.D.Tipo_Pessoa, 'Saldo Carga' ) > 0
        , ATTRN( 'ALL.D.Prazo', !ALL.D.Prazo, 'Prazo' )
          - DB( 'CRT.030.Carteira_Existentes', DB( '}ElementAttributes_ALL.D.Calendario', !ALL.D.Calendario, 'Previous Period' ), !ALL.D.Safra, 'RE', !ALL.D.Produto, !ALL.D.Canal, !ALL.D.Prazo, !ALL.D.Tipo_Pessoa, 'Parcelas Remanescentes' )
          + 1
        , 0
        )
    , IF( DB( 'CRT.030.Carteira_Existentes', DB( '}ElementAttributes_ALL.D.Calendario', !ALL.D.Calendario, 'Previous Period' ), !ALL.D.Safra, !ALL.D.Versao, !ALL.D.Produto, !ALL.D.Canal, !ALL.D.Prazo, !ALL.D.Tipo_Pessoa, 'SYS.MOB' ) >= 1
        & DB( 'CRT.030.Carteira_Existentes', DB( '}ElementAttributes_ALL.D.Calendario', !ALL.D.Calendario, 'Previous Period' ), !ALL.D.Safra, !ALL.D.Versao, !ALL.D.Produto, !ALL.D.Canal, !ALL.D.Prazo, !ALL.D.Tipo_Pessoa, 'SYS.MOB' ) < ATTRN( 'ALL.D.Prazo', !ALL.D.Prazo, 'Prazo' )
      , DB( 'CRT.030.Carteira_Existentes', DB( '}ElementAttributes_ALL.D.Calendario', !ALL.D.Calendario, 'Previous Period' ), !ALL.D.Safra, !ALL.D.Versao, !ALL.D.Produto, !ALL.D.Canal, !ALL.D.Prazo, !ALL.D.Tipo_Pessoa, 'SYS.MOB' ) + 1
      , 0
      )
    );

['CRT.M.030.Carteira_Existentes':'Saldo Inicial'] = N:
  IF( DB( 'PRE.001.Premissas_Gerais', DB( '}ElementAttributes_ALL.D.Calendario', !ALL.D.Calendario, 'Previous Period' ), !ALL.D.Versao, 'Real x Orcado' ) @= 'Real'
    , DB( 'CRT.030.Carteira_Existentes', DB( '}ElementAttributes_ALL.D.Calendario', !ALL.D.Calendario, 'Previous Period' ), !ALL.D.Safra, 'RE', !ALL.D.Produto, !ALL.D.Canal, !ALL.D.Prazo, !ALL.D.Tipo_Pessoa, 'Saldo Carga' )
    , DB( 'CRT.030.Carteira_Existentes', DB( '}ElementAttributes_ALL.D.Calendario', !ALL.D.Calendario, 'Previous Period' ), !ALL.D.Safra, !ALL.D.Versao, !ALL.D.Produto, !ALL.D.Canal, !ALL.D.Prazo, !ALL.D.Tipo_Pessoa, 'Saldo Final' )
    );

['CRT.M.030.Carteira_Existentes':'(-) Amortizacao'] = N:
  IF( ['CRT.M.030.Carteira_Existentes':'SYS.MOB'] = 0
    , 0
    , - ( ['CRT.M.030.Carteira_Existentes':'Saldo Inicial']
          * DB( 'CRT.015.Premissas_Safra', !ALL.D.Safra, !ALL.D.Versao, !ALL.D.Produto, !ALL.D.Prazo, TRIM( STR( ['CRT.M.030.Carteira_Existentes':'SYS.MOB'], 3, 0 ) ), '% Runoff' )
        )
    );

['CRT.M.030.Carteira_Existentes':'(-) LA Full'] = N:
  IF( ['CRT.M.030.Carteira_Existentes':'SYS.MOB'] = 0
    , 0
    , - ( ['CRT.M.030.Carteira_Existentes':'Saldo Inicial']
          * DB( 'CRT.015.Premissas_Safra', !ALL.D.Safra, !ALL.D.Versao, !ALL.D.Produto, !ALL.D.Prazo, TRIM( STR( ['CRT.M.030.Carteira_Existentes':'SYS.MOB'], 3, 0 ) ), '% LA Full' )
        )
    );

['CRT.M.030.Carteira_Existentes':'(-) LA Parcial'] = N:
  IF( ['CRT.M.030.Carteira_Existentes':'SYS.MOB'] = 0
    , 0
    , - ( ['CRT.M.030.Carteira_Existentes':'Saldo Inicial']
          * DB( 'CRT.015.Premissas_Safra', !ALL.D.Safra, !ALL.D.Versao, !ALL.D.Produto, !ALL.D.Prazo, TRIM( STR( ['CRT.M.030.Carteira_Existentes':'SYS.MOB'], 3, 0 ) ), '% LA Parcial' )
        )
    );

['CRT.M.030.Carteira_Existentes':'(-) WO'] = N:
  IF( ['CRT.M.030.Carteira_Existentes':'SYS.MOB'] = 0
    , 0
    , IF( ['CRT.M.030.Carteira_Existentes':'SYS.MOB'] = ATTRN( 'ALL.D.Prazo', !ALL.D.Prazo, 'Prazo' )
        , - ( ['CRT.M.030.Carteira_Existentes':'Saldo Inicial']
              + ['CRT.M.030.Carteira_Existentes':'(-) Amortizacao']
              + ['CRT.M.030.Carteira_Existentes':'(-) LA Total']
            )
        , - ( ['CRT.M.030.Carteira_Existentes':'Saldo Inicial']
              * DB( 'CRT.015.Premissas_Safra', !ALL.D.Safra, !ALL.D.Versao, !ALL.D.Produto, !ALL.D.Prazo, TRIM( STR( ['CRT.M.030.Carteira_Existentes':'SYS.MOB'], 3, 0 ) ), '% WO' )
            )
        )
    );

['CRT.M.030.Carteira_Existentes':'(+) Juros'] = N:
  ( ( 1 + DB( 'CRT.030.Carteira_Existentes', !ALL.D.Calendario, !ALL.D.Safra, 'RE', !ALL.D.Produto, !ALL.D.Canal, !ALL.D.Prazo, !ALL.D.Tipo_Pessoa, '% Taxa Media Carga' ) )
    ^ ( DB( 'PRE.001.Premissas_Gerais', !ALL.D.Calendario, !ALL.D.Versao, 'Dias Corridos' ) \ 30 ) - 1
  )
  * ['CRT.M.030.Carteira_Existentes':'Saldo Inicial'];

['CRT.M.030.Carteira_Existentes':'Saldo Final'] = N:
    ['CRT.M.030.Carteira_Existentes':'Saldo Inicial']
  + ['CRT.M.030.Carteira_Existentes':'(-) Amortizacao']
  + ['CRT.M.030.Carteira_Existentes':'(-) LA Total']
  + ['CRT.M.030.Carteira_Existentes':'(-) WO'];


FEEDERS;

['ALL.D.Versao':'RE','CRT.M.030.Carteira_Existentes':'Saldo Carga'] =>
    DB( 'CRT.030.Carteira_Existentes', DB( '}ElementAttributes_ALL.D.Calendario', !ALL.D.Calendario, 'Next Period' ), !ALL.D.Safra, 'Versoes Dinamicas', !ALL.D.Produto, !ALL.D.Canal, !ALL.D.Prazo, !ALL.D.Tipo_Pessoa, 'Saldo Inicial' )
  , DB( 'CRT.030.Carteira_Existentes', DB( '}ElementAttributes_ALL.D.Calendario', !ALL.D.Calendario, 'Next Period' ), !ALL.D.Safra, 'Versoes Dinamicas', !ALL.D.Produto, !ALL.D.Canal, !ALL.D.Prazo, !ALL.D.Tipo_Pessoa, 'SYS.MOB' )
  , DB( 'CRT.030.Carteira_Existentes', DB( '}ElementAttributes_ALL.D.Calendario', !ALL.D.Calendario, 'Next Period' ), !ALL.D.Safra, 'Versoes Dinamicas', !ALL.D.Produto, !ALL.D.Canal, !ALL.D.Prazo, !ALL.D.Tipo_Pessoa, 'Saldo Final' );

['ALL.D.Versao':'Versoes Dinamicas','CRT.M.030.Carteira_Existentes':'Saldo Final'] =>
    DB( 'CRT.030.Carteira_Existentes', DB( '}ElementAttributes_ALL.D.Calendario', !ALL.D.Calendario, 'Next Period' ), !ALL.D.Safra, !ALL.D.Versao, !ALL.D.Produto, !ALL.D.Canal, !ALL.D.Prazo, !ALL.D.Tipo_Pessoa, 'Saldo Inicial' )
  , DB( 'CRT.030.Carteira_Existentes', DB( '}ElementAttributes_ALL.D.Calendario', !ALL.D.Calendario, 'Next Period' ), !ALL.D.Safra, !ALL.D.Versao, !ALL.D.Produto, !ALL.D.Canal, !ALL.D.Prazo, !ALL.D.Tipo_Pessoa, 'SYS.MOB' )
  , DB( 'CRT.030.Carteira_Existentes', DB( '}ElementAttributes_ALL.D.Calendario', !ALL.D.Calendario, 'Next Period' ), !ALL.D.Safra, !ALL.D.Versao, !ALL.D.Produto, !ALL.D.Canal, !ALL.D.Prazo, !ALL.D.Tipo_Pessoa, 'Saldo Final' );

['ALL.D.Versao':'Versoes Dinamicas','CRT.M.030.Carteira_Existentes':'Saldo Inicial'] =>
    ['CRT.M.030.Carteira_Existentes':'(+) Juros']
  , ['CRT.M.030.Carteira_Existentes':'(-) Amortizacao']
  , ['CRT.M.030.Carteira_Existentes':'(-) LA Full']
  , ['CRT.M.030.Carteira_Existentes':'(-) LA Parcial']
  , ['CRT.M.030.Carteira_Existentes':'(-) WO'];

# Feeders externos - consolidada (todas as metricas puxadas por CRT.050) e receita
['ALL.D.Versao':'Versoes Dinamicas','CRT.M.030.Carteira_Existentes':'Saldo Final'] =>
    DB( 'CRT.050.Carteira_Consolidada', !ALL.D.Calendario, !ALL.D.Safra, !ALL.D.Versao, 'Existentes', !ALL.D.Produto, !ALL.D.Canal, !ALL.D.Prazo, 'Saldo Final' )
  , DB( 'REC.100.Receita_Financeira', !ALL.D.Calendario, !ALL.D.Safra, !ALL.D.Versao, !ALL.D.Produto, !ALL.D.Canal, 'Saldo Medio' );

['ALL.D.Versao':'Versoes Dinamicas','CRT.M.030.Carteira_Existentes':'Saldo Inicial'] =>
    DB( 'CRT.050.Carteira_Consolidada', !ALL.D.Calendario, !ALL.D.Safra, !ALL.D.Versao, 'Existentes', !ALL.D.Produto, !ALL.D.Canal, !ALL.D.Prazo, 'Saldo Inicial' );

['ALL.D.Versao':'Versoes Dinamicas','CRT.M.030.Carteira_Existentes':'(+) Juros'] =>
    DB( 'CRT.050.Carteira_Consolidada', !ALL.D.Calendario, !ALL.D.Safra, !ALL.D.Versao, 'Existentes', !ALL.D.Produto, !ALL.D.Canal, !ALL.D.Prazo, '(+) Juros' );

['ALL.D.Versao':'Versoes Dinamicas','CRT.M.030.Carteira_Existentes':'(-) Amortizacao'] =>
    DB( 'CRT.050.Carteira_Consolidada', !ALL.D.Calendario, !ALL.D.Safra, !ALL.D.Versao, 'Existentes', !ALL.D.Produto, !ALL.D.Canal, !ALL.D.Prazo, '(-) Amortizacao' );

['ALL.D.Versao':'Versoes Dinamicas','CRT.M.030.Carteira_Existentes':'(-) LA Full'] =>
    DB( 'CRT.050.Carteira_Consolidada', !ALL.D.Calendario, !ALL.D.Safra, !ALL.D.Versao, 'Existentes', !ALL.D.Produto, !ALL.D.Canal, !ALL.D.Prazo, '(-) LA Total' );

['ALL.D.Versao':'Versoes Dinamicas','CRT.M.030.Carteira_Existentes':'(-) LA Parcial'] =>
    DB( 'CRT.050.Carteira_Consolidada', !ALL.D.Calendario, !ALL.D.Safra, !ALL.D.Versao, 'Existentes', !ALL.D.Produto, !ALL.D.Canal, !ALL.D.Prazo, '(-) LA Total' );

['ALL.D.Versao':'Versoes Dinamicas','CRT.M.030.Carteira_Existentes':'(-) WO'] =>
    DB( 'CRT.050.Carteira_Consolidada', !ALL.D.Calendario, !ALL.D.Safra, !ALL.D.Versao, 'Existentes', !ALL.D.Produto, !ALL.D.Canal, !ALL.D.Prazo, '(-) WO' );
